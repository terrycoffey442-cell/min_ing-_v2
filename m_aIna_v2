local function FindDirModule(folderName, name)
    local f = Directory:FindFirstChild(folderName)
    if not f then return nil end
    for _, m in ipairs(f:GetDescendants()) do
        if m:IsA("ModuleScript") and m.Name == name then return m end
    end
end
local function RequireDir(folderName, name)
    local m = FindDirModule(folderName, name)
    if not m then return nil end
    local ok, r = pcall(require, m)
    return ok and r or nil
end

