            if okKind and (not onlyEvent or set[p.id]) then
                local avail = (p._am or 1) - (eq[uid] or 0)
                local n = math.floor(avail / cost)
                if n >= 1 then list[#list + 1] = { uid = uid, id = p.id, n = n } end
