local PickTier, lastClaimAt = 1, 0
local tierWarned = {}
local function ToolTier(t)
    local ok, dir = pcall(t.Directory, t)
    return ok and dir and tonumber(dir.Tier) or 1
end
-- acc mới: pickaxe free (Scrap Pickaxe) là prop INTERACT.WoodenPickaxe (tag MiningFreePickaxe, nút E) cạnh chỗ spawn khu 1.
-- VERIFIED 21/09: ClientModule của event gọi InstancingCmds.FireCustom("ClaimPickaxe") (= Network.Fire("Instancing_FireCustomFromClient", "ClaimPickaxe"));
-- gửi thêm tên instance như bản cũ thì server không nhận -> acc mới kẹt "no pickaxe" mãi.
local function ClaimFreePickaxe()
    local hrp = HRP()
    if not hrp then return false end
    local prop
    pcall(function() prop = workspace.__THINGS.__INSTANCE_CONTAINER.Active[Config.InstanceName].INTERACT:FindFirstChild("WoodenPickaxe") end)
    local dest = prop and prop.Position or Vector3.new(17100, 15.9, -8102) -- vị trí prop khu 1
    if (hrp.Position - dest).Magnitude > 8 then
        hrp.CFrame = CFrame.new(dest + Vector3.new(0, 2.5, 4))
        task.wait(1.2)
    end
    local ok, err = pcall(InstancingCmds.FireCustom, "ClaimPickaxe")
    if not ok then pcall(Network.Fire, "Instancing_FireCustomFromClient", "ClaimPickaxe") end
    Log("ClaimPickaxe -> %s %s", tostring(ok), tostring(err or ""))
    local t0 = os.clock()
    repeat task.wait(0.5) until ToolUtil.GetBestTool(lp, "Pickaxe") or os.clock() - t0 > 6
    return ToolUtil.GetBestTool(lp, "Pickaxe") ~= nil
end
local function EnsurePickaxe()
    local best = ToolUtil.GetBestTool(lp, "Pickaxe")
    if not best then
        SetStatus("Claim pickaxe")
        Log("Chưa có pickaxe -> nhận pickaxe free")
        if not ClaimFreePickaxe() then return false end
        best = ToolUtil.GetBestTool(lp, "Pickaxe")
        if not best then return false end
        Stats.lastEvent = "Claimed " .. best:GetId()
    end
    Stats.pickaxe = best:GetId()
    -- pickaxe khu N+1 = phần thưởng SpaceMineQuestN (DoQuests redeem); block Tier > pickaxe Tier thì KHÔNG đào được
    local tier = ToolTier(best)
    if tier ~= PickTier then
        PickTier = tier
        Log("Pickaxe: %s (Tier %d)", best:GetId(), tier)
        table.clear(tierWarned)
        if hardCache then table.clear(hardCache) end -- damage đổi -> tính lại block cứng
    end
    local sel = ToolUtil.GetSelectedTool(lp, "Pickaxe")
    if not sel or sel:GetId() ~= best:GetId() then
        Log("Chọn pickaxe tốt nhất: %s", best:GetId())
        pcall(ToolCmds.SetSelectedTool, best)
        task.wait(0.5)
    end
    return true
end

