local lastCombineAt = 0
-- Remote PetCraftingMachine_Craft bị server assert với mọi arg đã thử -> dùng chính UI của máy:
-- PlayerGui._MACHINES.PetCraftingMachine.Frame: UsingFrame.Content["<recipe>"] (chọn) rồi ObjectiveFrame.SubmitHolder.OkOne (craft 1)
local function PressButton(btn)
    local ok, conns = pcall(getconnections, btn.Activated)
    if ok and #conns > 0 then
        for _, c in ipairs(conns) do if c.Function then task.spawn(c.Function) end end
        return true
    end
    if firesignal then pcall(firesignal, btn.Activated) return true end
    return false
end
local function DoCombine()
    if not _UC["Auto Combine"] or os.clock() - lastCombineAt < Config.CombineEvery then return end
    lastCombineAt = os.clock()
    local gui = lp.PlayerGui:FindFirstChild("_MACHINES")
    local frame = gui and gui:FindFirstChild("PetCraftingMachine") and gui.PetCraftingMachine:FindFirstChild("Frame")
    if not frame then return end -- UI máy chưa được tạo (chưa từng vào khu 5 / chưa load)
    local content = frame:FindFirstChild("UsingFrame") and frame.UsingFrame:FindFirstChild("Content")
    local okOne = frame:FindFirstChild("ObjectiveFrame") and frame.ObjectiveFrame:FindFirstChild("SubmitHolder") and frame.ObjectiveFrame.SubmitHolder:FindFirstChild("OkOne")
    if not content or not okOne then return end
    local d = SaveData()
    local savings = (d.EventUpgrades and d.EventUpgrades.SpaceMineLessOresRequired) or 0
    local mult = 1 - ({ 0, 10, 20, 30, 40, 50 })[math.clamp(savings, 0, 5) + 1] / 100
    local upTo = tonumber(_UC["Combine Up To"]) or 4
    local keep = tonumber(_UC["Combine Keep"]) or 0
    local crafted = {}
    -- rung cao trước (gem hiếm trước), tối đa 6 lần craft / chu kỳ
    local budget = 6
    for i = #Config.CombineRecipes, 1, -1 do
        local r = Config.CombineRecipes[i]
        if r.idx <= upTo and budget > 0 then
            local need = math.ceil(r.n * mult)
            local btn = content:FindFirstChild(tostring(r.idx))
            while budget > 0 and btn and CountItem(r.input) - keep >= need do
                local out0 = CountItem(r.out)
                local in0 = CountItem(r.input)
                PressButton(btn) task.wait(0.5)
                PressButton(okOne) task.wait(1.3)
                budget -= 1
                if CountItem(r.out) > out0 or CountItem(r.input) < in0 then
                    crafted[r.out] = (crafted[r.out] or 0) + 1
                else
                    break -- không craft được (thiếu gem theo server / UI đổi) -> sang rung khác
                end
            end
        end
    end
    local parts = {}
    for k, v in pairs(crafted) do parts[#parts + 1] = k .. " x" .. v end
    if #parts > 0 then
        Log("Combine: %s", table.concat(parts, ", "))
        Stats.lastEvent = "Combine " .. table.concat(parts, ",")
    end
end

