-- MAIN LOOP
-- ============================================================
local function MainLoop()
    ApplyOptimize()
    CreateUI()
    HideEggAnim()
    HoldPatch()
    MagnetPatch()
    pcall(function() if AutoMineCmds.IsEnabled() then AutoMineCmds.Disable() Log("Tắt Auto Mine sót từ bản trước") end end)
    Stats.coins0 = GetSpaceCoins()
    Stats.pts0 = GetPoints()
    CheckNewPets()
    if _UC["Equip Best Pets"] then pcall(Network.Fire, "SM_Optimize") end
    Log("Start. Target zone %s. Bấm %s để dừng.", tostring(_UC["Target Zone"]), tostring(_UC["Stop Key"].Name))

    local idleSince = os.clock()
    local lastHop, lastHopBroken = nil, -1
    local lastStats, lastWebhook, lastPets = os.clock(), os.clock(), os.clock()
    local respawnLogged = false
    local idleStrikes, lastBrokenMark = 0, -1

    while Bot.running do
        if not _UC["Enabled"] then SetStatus("paused") task.wait(1) continue end
        if not EnsureInstance() then task.wait(3) continue end
        if not EnsurePickaxe() then SetStatus("no pickaxe") task.wait(3) continue end

        local loc = GetLocalWorld(8)
        if not loc then
            SetStatus("outside mine")
            local want = math.min(math.clamp(tonumber(_UC["Target Zone"]) or 5, 1, 5), HighestUnlockedZone(), PickaxeZone())
            Log("Không ở trong mine -> tele khu %d", want)
            TeleportToZoneTop(want)
            idleSince = os.clock()
            continue
        end
        if Stats.zone ~= ZoneOf(loc) then idleSince = os.clock() end -- vừa đổi khu / vào mine: reset watchdog
        Stats.zone = ZoneOf(loc)
        -- đứng ngoài vùng mine của world mình (vd tele nhầm chỗ) -> về mặt khu đó
        do
            local hrp = HRP()
            local inside = true
            if hrp then pcall(function() inside = loc:IsInsideXZ(hrp.Position) end) end
            if not inside then
                -- văng ra ngoài vùng (trượt khỏi mesh ore ở mép, bom đẩy...) -> nhảy về block gần nhất, giữ độ sâu; lặp 3 lần/15 s thì về mặt
                if os.clock() - (Bot.outsideAt or 0) > 15 then Bot.outsideN = 0 end
                Bot.outsideAt = os.clock()
                Bot.outsideN = (Bot.outsideN or 0) + 1
                -- lần 1-2: block gần nhất; từ lần 3: block trong lòng (cách mép >= 2), không về mặt (giữ độ sâu)
                local near = (Bot.outsideN < 3 and NearestExposedBlock(loc, 120)) or NearestExposedBlock(loc, 1e9, true) or NearestExposedBlock(loc, 1e9)
                if near then
                    Log("Đang ngoài vùng khu %d -> nhảy về block %s", Stats.zone, tostring(near.Pos))
                    HopTo(near)
                else
                    Log("Đang ngoài vùng khu %d -> tele về mặt", Stats.zone)
                    TeleportToZoneTop(Stats.zone)
                end
                idleSince = os.clock()
                continue
            end
        end

        -- việc định kỳ
        DoQuests()
        if DoZones(loc) then idleSince = os.clock() continue end
        DoUpgrades()
        DoBoosters()
        DoMerchant()
        DoCombine()
        if DoEggs(loc) then idleSince = os.clock() continue end -- sau chuyến egg/máy loc cũ có thể đã bị huỷ -> lấy lại
        DoFreeGifts()
        DoMail()
        DoBombs(loc)
        if os.clock() - lastPets > 5 then lastPets = os.clock() CheckNewPets() end
        if os.clock() - lastStats > Config.StatsEvery then
            lastStats = os.clock()
            local el = math.max(1, os.clock() - Stats.start)
            Log("=== %s | zone %d y=%d | blocks %d (%.0f/min) ore %d rej %d che %d | coins +%s pts +%s | eggs %d gold %d rb %d | %s",
                FmtTime(el), Stats.zone, Stats.layer, Stats.broken, Stats.broken / el * 60, Stats.ores, Stats.rejected, Stats.occluded,
                FmtNum(GetSpaceCoins() - Stats.coins0), FmtNum(GetPoints() - Stats.pts0), Stats.eggs, Stats.gold, Stats.rainbow, Stats.quest)
        end
        if os.clock() - lastWebhook > Config.WebhookEvery then
            lastWebhook = os.clock()
            local el = math.max(1, os.clock() - Stats.start)
            SendWebhook("📊 Space Mine stats", ("Uptime %s\nZone %d, layer %d | Pickaxe %s\nBlocks %d (%.0f/min), ore %d\nSpace Coins %s (+%s)\nGems: M%d SR%d He%d Ne%d DM%d\nEggs %d | Gold %d | Rainbow %d\nQuest: %s"):format(
                FmtTime(el), Stats.zone, Stats.layer, tostring(Stats.pickaxe), Stats.broken, Stats.broken / el * 60, Stats.ores,
                FmtNum(GetSpaceCoins()), FmtNum(GetSpaceCoins() - Stats.coins0),
                CountItem("Moonstone Gem"), CountItem("Star Ruby Gem"), CountItem("Helium-3 Gem"), CountItem("Nebulite Gem"), CountItem("Dark Matter Gem"),
                Stats.eggs, Stats.gold, Stats.rainbow, Stats.quest))
        end
        if os.clock() - (Bot.lastUI or 0) > 1 then Bot.lastUI = os.clock() UpdateUI() end

        -- mine đang reset
        if loc.Respawning then
            if not respawnLogged then Log("Mine đang reset -> chờ") respawnLogged = true end
            SetStatus("mine resetting")
            task.wait(1)
            continue
        elseif respawnLogged then
            respawnLogged = false
            hopVisited = {}
            Log("Mine reset xong -> farm tiếp")
        end

        TrackPending()
        local nPending = 0
        for _ in pairs(pending) do nPending += 1 end
        if nPending >= Config.MaxPending then task.wait(0.05) continue end

        local pb = GetFootPos(loc)
        if not pb then
            task.wait(0.5)
            pb = GetFootPos(loc)
            if not pb then
                local hrp = HRP()
                local near, nd
                for _, b in pairs(loc.Blocks) do
                    if BlockValid(b) and not b.TempBroken and hrp then
                        local c = BlockCenter(b)
                        local d = (c - hrp.Position).Magnitude + ((hrp.Position.Y - c.Y) < 0 and 500 or 0)
                        if not nd or d < nd then near, nd = b, d end
                    end
                end
                if near then HopTo(near) end
                continue
            end
        end
        Stats.layer = pb.Y

        -- AUTO MINE (game): quest cần đá không có ở layer này & không có block nào đang load -> để game đào xuống nhanh
        do
            local needs = Bot.questNeeds or {}
            local amWant, amWhy = false, nil
            local defer = _UC["Hard Rock Last"] and (Bot.questAnyLeft or 0) > 0 -- còn "any" -> farm rộng tầng mềm trước (trừ gate quest)
            if _UC["Auto Mine Quest"] ~= false then
                for id in pairs(needs) do
                    if not IsOre(id) and not hardCache[id] and (not defer or (Bot.gateNeeds and Bot.gateNeeds[id])) then
                        local seen = false
                        for _, b in pairs(loc.Blocks) do
                            if BlockValid(b) and BlockId(b) == id and math.abs(b.Pos.Y - pb.Y) <= 1 then seen = true break end
                        end
                        if not seen then amWant, amWhy = true, id end
                    end
                end
            end
            if amWant then
                -- có Core Charge (khoan 20 layer thẳng xuống) -> dùng trước, nhanh hơn Auto Mine
                if _UC["Auto Bomb"] and os.clock() - (Bot.coreAt or 0) > 15 and FindConsumableUID("Core Charge") then
                    Bot.coreAt = os.clock()
                    if UseBomb("Core Charge") then Log("Core Charge: khoan xuống tìm %s", amWhy) task.wait(4) idleSince = os.clock() continue end
                end
                local en = false
                pcall(function() en = AutoMineCmds.IsEnabled() end)
                if not en and os.clock() - (Bot.amEnableAt or 0) > 3 then
                    Bot.amEnableAt = os.clock()
                    -- Enable() gọi GetBlockUnderPlayer (= GetPlayerBlock, trả nil ~70 % frame với avatar này) -> "no block under foot"
                    -- -> TeleportLocalPlayerToRandomBlock văng sang khu khác. Chờ đúng frame GetPlayerBlock có block rồi mới bật
                    for _ = 1, 90 do
                        local okp, p = pcall(loc.GetPlayerBlock, loc, lp)
                        if okp and p then break end
                        RunService.Heartbeat:Wait()
                    end
                    -- sau chuyến egg/máy (khu 1) GetLocal() có thể còn trả world khu 1 vài giây -> Enable lúc đó = random block khu 1
                    if not SameWorld(loc) then Dbg("Auto Mine: world chưa khớp, chờ") task.wait(0.5) continue end
                    local ok, err = pcall(AutoMineCmds.Enable)
                    Log("Auto Mine ON (quest cần %s, không có ở layer y=%d) -> %s %s", amWhy, pb.Y, tostring(ok), tostring(err or ""))
                    Bot.autoMineOn = true
                    Bot.amLastY, Bot.amLastProgressAt = pb.Y, os.clock()
                elseif en then
                    -- watchdog: Auto Mine của game kẹt (mine reset đưa lên mặt nhưng target cũ còn ở sâu; hoặc đứng trên ore) -> 8 s không xuống layer nào thì bật lại
                    if Bot.amLastY == nil or pb.Y < Bot.amLastY then Bot.amLastY, Bot.amLastProgressAt = pb.Y, os.clock() end
                    local tgtY
                    pcall(function() local me = loc.Players[lp] tgtY = me and me.Target and me.Target.Y end)
                    -- target Auto Mine bình thường ở dưới chân 1-5 block; kẹt thật = target ở TRÊN (mine reset đưa lên mặt, target cũ ở sâu -> pb.Y > tgtY... nhưng
                    -- pb reset về 0 nên tgtY < pb.Y - 8) hoặc 30 s không xuống (Ruby dưới chân 56 s là bình thường -> không tính)
                    local tgtFar = tgtY and (tgtY < pb.Y - 8 or tgtY > pb.Y + 1)
                    if os.clock() - (Bot.amLastProgressAt or 0) > 60 or tgtFar then
                        Log("Auto Mine kẹt (y=%d %s) -> bật lại", pb.Y, tgtFar and ("target y=" .. tgtY) or "không xuống 60 s")
                        pcall(AutoMineCmds.Disable)
                        task.wait(0.6)
                        for _ = 1, 90 do
                            local okp, p = pcall(loc.GetPlayerBlock, loc, lp)
                            if okp and p then break end
                            RunService.Heartbeat:Wait()
                        end
                        if SameWorld(loc) then pcall(AutoMineCmds.Enable) end
                        Bot.amLastY, Bot.amLastProgressAt = pb.Y, os.clock()
                    end
                end
                SetStatus(("auto mine zone %d y=%d"):format(Stats.zone, pb.Y))
                idleSince = os.clock()
                task.wait(0.5)
                continue
            elseif Bot.autoMineOn then
                pcall(AutoMineCmds.Disable)
                Bot.autoMineOn = false
                Log("Auto Mine OFF -> quay lại full-clear")
            end
        end

        -- (fallback) quest cần đá mà layer này không có -> thu bán kính đào để xuống nhanh
        local reach = Config.ReachStuds
        local qr = tonumber(_UC["Quest Dig Radius"]) or 0
        if _UC["Hard Rock Last"] and (Bot.questAnyLeft or 0) > 0 and not next(Bot.gateNeeds or {}) then qr = 0 end -- còn "any" -> không đào hẹp (trừ khi gate cần)
        if qr > 0 then
            local needs = Bot.questNeeds or {}
            local rockNeed, seen = false, false
            for id in pairs(needs) do if not IsOre(id) then rockNeed = true end end
            if rockNeed then
                for _, b in pairs(loc.Blocks) do
                    if b.Pos.Y == pb.Y and BlockValid(b) and needs[BlockId(b)] then seen = true break end
                end
                if not seen then reach = qr end
            end
        end
        if (reach < Config.ReachStuds) ~= (Bot.questDig == true) then
            Bot.questDig = reach < Config.ReachStuds
            Log(Bot.questDig and "Quest cần đá không có ở layer y=%d -> đào hẹp (r=%d) để xuống" or "Layer y=%d có đá quest -> vét đủ tầm", pb.Y, reach)
        end
        local target, layerLeft, farBest, farCount, ghostBest = PickTarget(loc, pb, reach)
        if not target and ghostBest and not farBest then target = ghostBest end -- vét ghost cuối layer
        local targetIsOre = target and IsOre(BlockId(target))
        local farIsOre = farBest and IsOre(BlockId(farBest))
        local hopsThisLayer = 0
        for _, v in ipairs(hopVisited) do if v.y == pb.Y then hopsThisLayer += 1 end end
        local hopLoop = farBest and lastHop == farBest and Stats.broken == lastHopBroken
        -- ore xa: luôn được hop (không tính budget HopsPerLayer) -> không bỏ sót ore trên layer
        -- đang đào hẹp tìm đá quest: không hop (kể cả ore) để không leo ra khỏi hố
        local canHop = farBest ~= nil and not hopLoop and not Bot.questDig
            and ((farIsOre and _UC["Hop Far Ore"] ~= false) or (not farIsOre and _UC["Hop Far Blocks"] and hopsThisLayer < Config.HopsPerLayer))
        local wantDescend = not targetIsOre and layerLeft <= Config.DescendWhenLeft and not canHop
        -- Ore First: có ore ngoài tầm mà trong tầm không có ore -> đi lấy ngay (đứng lại đó, lấy tiếp ore gần nhất)
        local oreFirst = _UC["Ore First"] and farIsOre and not targetIsOre and not hopLoop and not Bot.questDig

        if oreFirst then
            if nPending > 0 then TrackPending() end
            lastHop, lastHopBroken = farBest, Stats.broken
            local hopped = HopNear(loc, farBest)
            local h2 = HRP()
            if hopped and h2 and (BlockCenter(farBest) - h2.Position).Magnitude <= Config.ReachStuds then
                task.wait(0.1)
                if MineBlock(loc, farBest, true) then idleSince = os.clock() end
            else
                skipUntil[farBest] = os.clock() + 60
            end
        elseif wantDescend then
            if nPending > 0 then task.wait(0.1) continue end
            local below = FindExposedBelow(loc, pb, 3)
            if below then
                SetStatus(("mining zone %d y=%d"):format(Stats.zone, below.Pos.Y))
                Dbg("Layer y=%d xong -> xuống y=%d", pb.Y, below.Pos.Y)
                hopVisited = { { y = below.Pos.Y, pos = BlockCenter(below) } }
                HopTo(below)
                idleSince = os.clock()
            elseif target then
                if MineBlock(loc, target, targetIsOre) then idleSince = os.clock() end
            else
                local atBottom = false
                pcall(function() atBottom = loc:IsAtBottom() end)
                if atBottom or os.clock() - idleSince > 8 then
                    Log("Đáy / hết layer -> về mặt")
                    SetStatus("return to top")
                    ReturnToTop(loc)
                    idleSince = os.clock()
                else
                    task.wait(0.5)
                end
            end
        elseif target and not targetIsOre and _UC["Any On Top"] and pb.Y < -3 and (Bot.questAnyLeft or 0) > 0
            and not next(Bot.gateNeeds or {}) and (hardFrames[BlockId(target)] or 0) / math.max(20, tonumber(_UC["FPS"]) or 60) > 0.5
            and os.clock() - (Bot.topAt or 0) > 30 then
            -- tầng chậm, không còn ore, quest chỉ cần đếm block -> lên mặt đào tầng nhanh
            Bot.topAt = os.clock()
            Log("Tầng y=%d block chậm (%s) -> về mặt farm tầng nhanh cho 'any'", pb.Y, BlockId(target))
            SetStatus("return to top")
            ReturnToTop(loc)
            idleSince = os.clock()
        elseif target then
            SetStatus(("%s zone %d y=%d"):format(Bot.questDig and "digging" or "mining", Stats.zone, pb.Y))
            local ok, why = MineBlock(loc, target, targetIsOre)
            if ok then
                idleSince = os.clock()
            elseif why == "occluded" and targetIsOre and Bot.questDig then
                skipUntil[target] = os.clock() + 15 -- đang đào hẹp: ore ngoài hố bị che -> bỏ qua, không hop ra
            elseif why == "occluded" and targetIsOre and (oreHopTried[target] or 0) < 2 then
                -- ore bị che: đứng sát nó rồi đào lại ngay (không chờ 3 s)
                oreHopTried[target] = (oreHopTried[target] or 0) + 1
                Dbg("Ore %s bị che -> hop sát", tostring(target.Pos))
                local _, onTop = HopNear(loc, target)
                skipUntil[target] = 0
                if onTop then
                    -- đứng trên chính ore: đào block chân (rơi 1 layer)
                    if MineBlock(loc, target, true) then idleSince = os.clock() end
                end
            elseif why == "occluded" and targetIsOre then
                skipUntil[target] = os.clock() + 30 -- đã hop 2 lần vẫn che -> bỏ qua lâu hơn
            end
        elseif canHop then
            if nPending > 0 then task.wait(0.1) continue end
            Dbg("Hop %d/%d tới %s%s (còn %d xa)", hopsThisLayer + 1, Config.HopsPerLayer, tostring(farBest.Pos), farIsOre and " (ore)" or "", farCount)
            lastHop, lastHopBroken = farBest, Stats.broken
            if farIsOre then
                -- đi lấy ore xa (kể cả layer trên) rồi quay về chỗ đang đứng để không bỏ dở layer
                local h = HRP()
                local backCF = h and h.CFrame
                -- sweep: đi lấy ore gần nhất, rồi từ đó lấy tiếp ore gần nhất... (không tele về giữa chừng), xong mới quay về
                local cur, cd, n = farBest, nil, 0
                while cur and n < 80 and Bot.running and not loc.Respawning do
                    local h2 = HRP()
                    local dist = h2 and (BlockCenter(cur) - h2.Position).Magnitude or 1e9
                    if dist > Config.ReachStuds then
                        if not HopNear(loc, cur) then skipUntil[cur] = os.clock() + 60 cur = nil break end
                        h2 = HRP()
                        dist = h2 and (BlockCenter(cur) - h2.Position).Magnitude or 1e9
                    end
                    if dist <= Config.ReachStuds then
                        local okO = MineBlock(loc, cur, true)
                        if okO then idleSince = os.clock() n += 1 else skipUntil[cur] = math.max(skipUntil[cur] or 0, os.clock() + 20) end
                    else
                        skipUntil[cur] = os.clock() + 60
                    end
                    cur, cd = NearestOre(loc)
                end
                if n > 1 then Dbg("Sweep ore: %d cục", n) end
                if backCF and HRP() then HRP().CFrame = backCF task.wait(0.4) end
            else
                table.insert(hopVisited, { y = farBest.Pos.Y, pos = BlockCenter(farBest) })
                HopTo(farBest)
            end
            idleSince = os.clock()
        else
            task.wait(0.5)
        end

        if os.clock() - idleSince > 25 then
            idleStrikes = (idleStrikes or 0) + 1
            if idleStrikes == 1 then
                -- thử lại tại chỗ trước: xoá bảng skip/pending/hop rồi quét lại
                Log("25s không đào được gì -> reset bảng skip, thử lại")
                skipUntil, ghostFails, pending, hopVisited, oreHopTried = {}, {}, {}, {}, {}
            else
                Log("Vẫn không đào được -> về mặt")
                ReturnToTop(loc)
                idleStrikes = 0
            end
            idleSince = os.clock()
        elseif idleStrikes and os.clock() - idleSince < 5 and Stats.broken > (lastBrokenMark or -1) then
            idleStrikes = 0
        end
        lastBrokenMark = Stats.broken
    end
    SetStatus("stopped")
    Log("Stopped.")
end

-- ============================================================
-- Stop / start
-- ============================================================
function Bot.Stop(reason)
    Bot.running = false
    pcall(function() if AutoMineCmds.IsEnabled() then AutoMineCmds.Disable() end end)
    Bot.target = nil
    HoldUnpatch()
    MagnetUnpatch()
    pcall(function() if antiAfkConn then antiAfkConn:Disconnect() end end)
    pcall(function() for _, c in ipairs(eggAnimConns) do c:Disconnect() end end)
    pcall(function() if gui then gui:Destroy() end end)
    pcall(function() RunService:Set3dRenderingEnabled(true) end)
    Log("Stop (%s)", tostring(reason))
end

UIS.InputBegan:Connect(function(input, gp)
    if not gp and input.KeyCode == _UC["Stop Key"] then Bot.Stop("stop key") end
end)

task.spawn(function()
    while Bot.running do
        local ok, err = pcall(MainLoop)
        if not ok then
            Log("CRASH: %s -> restart sau 3s", tostring(err))
            task.wait(3)
        else
            break
        end
    end
end)
