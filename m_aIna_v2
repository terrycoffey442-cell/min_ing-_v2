-- trả về: map blockId -> số còn thiếu (để ưu tiên), và tên quest đang làm
local function QuestNeeds()
    local d = SaveData()
    local needs, label = {}, "done"
    Bot.questAnyLeft = 0
    local nq = d.NPCQuests or {}
    for i, qid in ipairs(Config.Quests) do
        local q = nq[qid]
        if not q then
            -- chưa được assign: quest i chỉ mở khi quest i-1 xong; Ensure để server tạo
            if i == 1 or (nq[Config.Quests[i - 1]] and nq[Config.Quests[i - 1]].Completed) then
                label = qid .. " (chưa nhận)"
                return needs, label, qid, "ensure"
            end
        elseif not q.Completed then
            local parts = {}
            for _, sub in ipairs(q.Quests or {}) do
                local left = (sub.Amount or 0) - (sub.Progress or 0)
                if left > 0 then
                    if sub.OreID then needs[sub.OreID] = left else Bot.questAnyLeft = (Bot.questAnyLeft or 0) + left end
                    table.insert(parts, (sub.OreID or "any") .. " " .. (sub.Progress or 0) .. "/" .. (sub.Amount or 0))
                end
            end
            label = qid:gsub("SpaceMine", "") .. ": " .. (#parts > 0 and table.concat(parts, ", ") or "READY")
            return needs, label, qid, (#parts == 0) and "ready" or "progress"
        end
    end
    return needs, label, nil, "done"
end

local lastQuestAt = 0
local function DoQuests()
    if not _UC["Auto Quest"] or os.clock() - lastQuestAt < Config.QuestEvery then return end
    lastQuestAt = os.clock()
    local needs, label, qid, state = QuestNeeds()
    -- gate quest của khu kế tiếp (vd "Mine 25 Comet Ice" = OreID Sand) cũng được ưu tiên
    local qa = InstanceVars().QuestActive
    Bot.gateNeeds = {}
    if qa and qa.OreID and (qa.Amount or 0) > (qa.Progress or 0) then
        needs[qa.OreID] = math.max(needs[qa.OreID] or 0, qa.Amount - (qa.Progress or 0))
        Bot.gateNeeds[qa.OreID] = true -- gate quest (mở khu kế) không bị Hard Rock Last hoãn
        label = label .. (" | gate%s: %s %d/%d"):format(tostring(InstanceVars().QuestZoneNumber or "?"), qa.OreID, qa.Progress or 0, qa.Amount or 0)
    end
    Stats.quest = label
    Bot.questNeeds = needs
    if state == "ensure" and qid then
        pcall(Network.Invoke, "NPC Quests: Ensure", qid)
    elseif state == "ready" and qid then
        -- kiểm tra gem trả (RewardCost)
        local dir = RequireDir("NPCQuests", "NPCQuests | " .. qid)
        local cost = dir and dir.RewardCost and dir.RewardCost._data
        if cost and CountItem(cost.id) < (cost._am or 1) then
            Stats.quest = label .. (" | cần %d %s"):format(cost._am or 1, cost.id)
            return
        end
        Log("Claim %s ...", qid)
        local ok, res, err = pcall(Network.Invoke, "NPC Quests: Redeem", qid)
        Log("Redeem %s -> %s %s", qid, tostring(ok and res), tostring(err or ""))
        if ok and res then
            Stats.lastEvent = "Claimed " .. qid
            SendWebhook("⛏ Pickaxe mới", qid .. " claimed", 0x2ecc71)
            task.wait(1.5)
            EnsurePickaxe()
        end
    end
end

-- ============================================================
-- Zones (gate)
-- ============================================================
local lastZoneAt = 0
local function DoZones(loc)
    if os.clock() - lastZoneAt < Config.ZoneEvery then return end
    lastZoneAt = os.clock()
    local targetZone = math.clamp(tonumber(_UC["Target Zone"]) or 5, 1, 5)
    local highest = HighestUnlockedZone()
    -- mở khu kế tiếp
    if _UC["Auto Unlock Zone"] and highest < targetZone then
        local nextZone = highest + 1
        local iv = InstanceVars()
        local qa = iv.QuestActive
        local questOk = (not qa) or ((qa.Progress or 0) >= (qa.Amount or 0))
        if questOk then
            local ok, res, err = pcall(Network.Invoke, "InstanceZones_RequestPurchase", Config.InstanceName, nextZone)
            if ok and res then
                Log("Mở khu %d thành công", nextZone)
                Stats.lastEvent = "Unlock zone " .. nextZone
                SendWebhook("🚪 Mở khu " .. nextZone, "Space Coins còn " .. FmtNum(GetSpaceCoins()), 0x9b59b6)
                task.wait(1)
                highest = HighestUnlockedZone()
            else
                Dbg("Chưa mở được khu %d: %s (coins %s, quest %s/%s)", nextZone, tostring(res or err), FmtNum(GetSpaceCoins()), tostring(qa and qa.Progress), tostring(qa and qa.Amount))
            end
        end
    end
    -- đứng đúng khu (không đi quá khu chưa lấy pickaxe)
    local want = math.min(targetZone, highest, PickaxeZone())
    local cur = ZoneOf(loc)
    if cur ~= want then
        Log("Chuyển sang khu %d (đang ở %d)", want, cur)
        SetStatus("Tele zone " .. want)
        TeleportToZoneTop(want)
        return true -- world đổi, vòng ngoài lấy lại loc
    end
end

