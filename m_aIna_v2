-- danh sách { uid, id, n } cho máy kind ("Gold": pet thường -> gold, "Rainbow": pet gold -> rainbow)
local function MachineCandidates(kind)
    local cost = MachineCost(kind)
    local eq = EquippedCount()
    local onlyEvent = _UC["Machine Pets"] ~= "all"
    local set = EventPetSet()
    local list = {}
    for uid, p in pairs(SaveData().Inventory.Pet or {}) do
        if type(p) == "table" and p.id and not p.l and not p.lock then
