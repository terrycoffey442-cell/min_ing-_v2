local function SendWebhook(title, desc, color)
    local url = _UC["Webhook URL"]
    if not url or url == "" or not httpRequest then return end
    pcall(function()
        local tag = _UC["Discord Tag ID"]
        local body = {
            content = (tag ~= "" and ("<@" .. tag .. ">") or nil),
            embeds = { {
                title = title, description = desc, color = color or 0x3498db,
                footer = { text = lp.Name .. " • Space Mine Kaitun" },
            } },
        }
        httpRequest({ Url = url, Method = "POST", Headers = { ["Content-Type"] = "application/json" }, Body = HttpService:JSONEncode(body) })
    end)
end

-- pet mới (Huge/Titanic/Gargantuan) -> webhook
local function SnapshotPets()
    local d = SaveData()
    local t = {}
    for uid, p in pairs(d.Inventory.Pet or {}) do
        local id = p.id or ""
        if id:find("^Huge ") or id:find("^Titanic ") or id:find("^Gargantuan ") then t[uid] = id end
    end
    return t
end
local function CheckNewPets()
    local now = SnapshotPets()
    for uid, id in pairs(now) do
        if not Stats.pets[uid] then
            Stats.pets[uid] = id
            if next(Stats.pets) ~= nil and Stats.petsInit then
                Stats.lastEvent = "NEW " .. id
                Log("*** PET MỚI: %s ***", id)
                SendWebhook("🎉 " .. id, ("Zone %d, layer %d\nBlocks: %d | Space Coins: %s"):format(Stats.zone, Stats.layer, Stats.broken, FmtNum(GetSpaceCoins())), 0xf1c40f)
            end
        end
    end
    Stats.petsInit = true
end

