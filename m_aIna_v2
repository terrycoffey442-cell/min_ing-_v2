local function SaveData() return Save.Get() end

local function CountItem(id)
    local d = SaveData()
    if not d or not d.Inventory then return 0 end
    local n = 0
    for _, cat in pairs(d.Inventory) do
        if type(cat) == "table" then
            for _, it in pairs(cat) do
                if type(it) == "table" and it.id == id then n += (it._am or 1) end
            end
        end
    end
    return n
end

local function GetSpaceCoins()
    local d = SaveData()
    for _, it in pairs(d.Inventory.Currency or {}) do
        if it.id == "SpaceCoins" then return it._am or 0 end
    end
    return 0
end

local function GetPoints() return SaveData().SpaceMinePoints or 0 end

local function FindConsumableUID(id)
    local d = SaveData()
    for uid, it in pairs(d.Inventory.Consumable or {}) do
        if it.id == id and (it._am or 1) > 0 then return uid, it._am or 1 end
    end
end

local function InstanceVars()
    local d = SaveData()
    return d.InstanceVars and d.InstanceVars[Config.InstanceName] or {}
end

local function IsZoneUnlocked(n)
    if n <= 1 then return true end
    local iz = InstanceVars().InstanceZones or {}
    return iz["__Zone_" .. n] == true
end

local function HighestUnlockedZone()
    local h = 1
    for n = 2, 5 do if IsZoneUnlocked(n) then h = n end end
    return h
end
-- khu thấp nhất mà quest pickaxe (SpaceMineQuestN) chưa Completed -> phải ở lại khu đó
local function PickaxeZone()
    if not _UC["Pickaxe First"] then return 5 end
    local nq = SaveData().NPCQuests or {}
    for n = 1, 5 do
        local q = nq["SpaceMineQuest" .. n]
        if not (q and q.Completed) then return n end
    end
    return 5
end

