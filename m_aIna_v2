local lastUpgradeAt = 0
local function DoUpgrades()
    if not _UC["Auto Upgrade"] or os.clock() - lastUpgradeAt < Config.UpgradeEvery then return end
    lastUpgradeAt = os.clock()
    local d = SaveData()
    local owned = d.EventUpgrades or {}
    local gems = CountItem(Config.UpgradeGem) - (tonumber(_UC["Upgrade Reserve"]) or 0)
    -- không mua nếu quest đang cần Helium-3 Gem làm RewardCost (quest 4/5 cần Star Ruby, nên thường ok)
    for _, id in ipairs(Config.Upgrades) do
        local dir = RequireDir("EventUpgrades", "EventUpgrade | " .. id)
        if dir and dir.TierCosts then
            local tier = owned[id] or 0
            local nextCost = dir.TierCosts[tier + 1]
            if nextCost and nextCost._data and gems >= (nextCost._data._am or 0) then
                local ok, res, err = pcall(Network.Invoke, "EventUpgrades: Purchase", id)
                Log("Upgrade %s T%d (%d gem) -> %s %s", id, tier + 1, nextCost._data._am or 0, tostring(ok and res), tostring(err or ""))
                if ok and res then
                    Stats.lastEvent = ("%s T%d"):format(dir.Name or id, tier + 1)
                    return -- 1 upgrade / chu kỳ
                end
            end
        end
    end
end

local boosterUsedAt = {}
local lastBoosterAt = 0
local function DoBoosters()
    if not _UC["Auto Booster"] or os.clock() - lastBoosterAt < Config.BoosterEvery then return end
    lastBoosterAt = os.clock()
    for _, id in ipairs(Config.Boosters) do
        if os.clock() - (boosterUsedAt[id] or -1e9) > Config.BoosterDuration then
            local uid = FindConsumableUID(id)
            if uid then
                local ok, res = pcall(Network.Invoke, "Consumables_Consume", uid, 1)
                Log("Dùng %s -> %s", id, tostring(ok and res))
                if ok and res then boosterUsedAt[id] = os.clock() end
            end
        end
    end
end

local lastBombAt = 0
local function UseBomb(id)
    local uid = FindConsumableUID(id)
    if not uid then return false end
    local ok, res = pcall(Network.Invoke, "Consumables_Consume", uid, 1)
    if ok and res then
        lastBombAt = os.clock()
        Stats.bombs = (Stats.bombs or 0) + 1
        Dbg("Bom: %s", id)
        return true
    end
    Log("Dùng %s thất bại: %s", id, tostring(res))
    return false
end
local function DoBombs(loc)
    if not _UC["Auto Bomb"] or os.clock() - lastBombAt < (tonumber(_UC["Bomb Every"]) or 12) then return end
    if not loc or loc.Respawning or Bot.autoMineOn then return end
    for _, id in ipairs(_UC["Bomb Use"] or {}) do
        if UseBomb(id) then return end -- không chờ nổ: bom phá song song, bot đào tiếp ngay
    end
    lastBombAt = os.clock() -- không có bom -> chờ chu kỳ sau
end

local lastMerchantAt = 0
local merchantSeed, merchantDone = nil, {}
local function DoMerchant()
    if not _UC["Auto Merchant"] or os.clock() - lastMerchantAt < Config.MerchantEvery then return end
    lastMerchantAt = os.clock()
    if GetSpaceCoins() <= (tonumber(_UC["Merchant Reserve"]) or 0) then return end
    -- Merchant_GetOffers trả nil (offer sinh client-side từ Seed) -> cứ RequestPurchase từng slot, server tự validate.
    -- MerchantPurchases.SpaceMineMerchant: Seed đổi = merchant refresh, Purchases[slot] = số lần đã mua
    local mp = SaveData().MerchantPurchases and SaveData().MerchantPurchases.SpaceMineMerchant or {}
    if mp.Seed ~= merchantSeed then merchantSeed = mp.Seed merchantDone = {} end
    local bought = {}
    for slot = 1, tonumber(_UC["Merchant Slots"]) or 6 do
        if not merchantDone[slot] then
            local n = 0
            for _ = 1, 3 do -- stock tối đa 3
                local okb, res = pcall(Network.Invoke, "Merchant_RequestPurchase", "SpaceMineMerchant", slot)
                if okb and res == true then n += 1 task.wait(0.4) else break end
                if GetSpaceCoins() <= (tonumber(_UC["Merchant Reserve"]) or 0) then break end
            end
