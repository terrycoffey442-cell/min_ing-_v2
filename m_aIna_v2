-- GIỮ ĐỂ PHÁ (VERIFIED 21/09): client tích damage mỗi frame vào loc.Players[lp].TargetDamage (ProcessLocalDamage);
-- HP (Strength*10) về 0 -> client TỰ gửi ZJ_Commit + SimulateBreak, server xoá ngay (Dirt 0.37 s, Sapphire 28 s đều vỡ).
-- Vấn đề cũ: MiningFrontend mỗi 0.1 s gọi LocalSetTarget(IsInputDown() and GetSelectedBlock() or nil) -> không giữ chuột
-- thì target bị xoá, damage về 0 -> chỉ block <= ~7 frame vỡ được; commit thủ công sớm thì server không nhận với block lâu.
-- Fix: patch 2 hàm đó (ToolCmds.BlockInteraction.GetSelectedBlock / MiningFrontend.GenericInput.IsInputDown) trả về block
-- bot đang giữ -> frontend tự giữ target, tự swing pickaxe + LJ_Pulse như người chơi giữ chuột.
-- ============================================================
local PickaxeUtil_ComputeDamage = PickaxeUtil.ComputeDamage
BlockDamage = function(b)
    local ok, dir = pcall(b.GetDirectory, b)
    if not ok or not dir then return 1 end
    local sel = ToolUtil.GetSelectedTool(lp, "Pickaxe")
    local best = ToolUtil.GetBestTool(lp, "Pickaxe")
    local ok2, dmg = pcall(PickaxeUtil_ComputeDamage, lp, sel, best, dir)
    if ok2 and tonumber(dmg) and dmg > 0 then return dmg end
    local ok3, dmg3 = pcall(PickaxeUtil.GetPickaxeDamage, lp, dir)
    return (ok3 and tonumber(dmg3) and dmg3 > 0) and dmg3 or 1
end
local holdOrig = {}
local function HoldPatch()
    if holdOrig.done then return true end
    local ok, err = pcall(function()
        local BI = require(Client.ToolCmds:WaitForChild("BlockInteraction", 5))
        local GI = require(Client.ToolCmds.MiningFrontend:WaitForChild("GenericInput", 5))
        pcall(setreadonly, BI, false) pcall(setreadonly, GI, false)
        holdOrig.BI, holdOrig.GI = BI, GI
        holdOrig.GetSelectedBlock, holdOrig.IsInputDown = BI.GetSelectedBlock, GI.IsInputDown
        BI.GetSelectedBlock = function(...)
            local h = Bot.hold
            if h then return h end
            return holdOrig.GetSelectedBlock(...)
        end
        GI.IsInputDown = function(...)
            if Bot.hold then return true end
            return holdOrig.IsInputDown(...)
        end
    end)
    holdOrig.done = ok
    if ok then Log("Hold patch: BlockInteraction.GetSelectedBlock + GenericInput.IsInputDown") else Log("Hold patch LỖI: %s", tostring(err)) end
    return ok
end
local function HoldUnpatch()
    Bot.hold = nil
    if not holdOrig.done then return end
    pcall(function()
        holdOrig.BI.GetSelectedBlock = holdOrig.GetSelectedBlock
        holdOrig.GI.IsInputDown = holdOrig.IsInputDown
    end)
    holdOrig.done = false
end
local function MyTargetDamage(loc)
    local me = loc.Players and loc.Players[lp]
    return me and me.TargetDamage or 0, me and me.Target
end
-- sync=true: chờ server xoá Part (ore, ghost retry, block lâu). sync=false: client vỡ (TempBroken) là sang block kế, server xác nhận sau (pending)
local function MineBlock(loc, b, sync)
    local id = BlockId(b)
    local hp = BlockHP(b)
    local fps = math.max(20, tonumber(_UC["FPS"]) or 60)
    local dmg = BlockDamage(b)
    local frames = math.max(1, math.ceil(hp / (dmg / fps)))
    local clientSec = hp / dmg -- client tích damage theo dt thật -> ~HP/dmg giây bất kể FPS
    local hard = frames > Config.HardFrames
    if clientSec > 3 then sync = true end -- block lâu (> 3 s): đứng chờ server xoá cho chắc; block ngắn xếp hàng pending để chồng lấp
    local timeout = clientSec * 1.3 + 2
    local t0 = os.clock()
    local tBroken = nil
    if b.TempBroken then sync = true; timeout = Config.ConfirmTimeout; tBroken = t0 end
    Bot.target = b
    Bot.hold = b
    if not SetTarget(loc, b) then
        Bot.hold = nil Bot.target = nil
        skipUntil[b] = os.clock() + 30
        return false
    end
    local lastDmg, lastDmgAt, lastUI = -1, t0, 0
    while os.clock() - t0 < timeout do
        if not Bot.running then Bot.hold = nil Bot.target = nil return false end
        if not b.Part or b.Part.Parent == nil then
            Bot.hold = nil Bot.target = nil
            Confirm(b, id, t0)
            return true
        end
        if b.TempBroken then
            -- client đã commit (HP về 0) -> server xoá sau ~0.1-0.3 s
            tBroken = tBroken or os.clock()
            Bot.hold = nil
            if not sync then
                RunService.Heartbeat:Wait()
                if Config.PostBreakGap > 0 then task.wait(Config.PostBreakGap) end
                Bot.target = nil
                pending[b] = { t0 = tBroken, id = id }
                return true
            end
            if os.clock() - tBroken > Config.ConfirmTimeout then
                ghostFails[b] = (ghostFails[b] or 0) + 1
                Bot.target = nil
                skipUntil[b] = os.clock() + (ghostFails[b] >= Config.GhostMaxFails and 600 or Config.GhostSkip)
                return false
            end
            task.wait()
        else
            RunService.Heartbeat:Wait()
            local cur, tgt = MyTargetDamage(loc)
            if tgt == nil or tgt ~= b.Pos then
                -- target bị xoá (đổi tool / frontend) -> đặt lại; damage đã về 0 nhưng frontend giữ nên chỉ xảy ra khi bị che / ngoài tầm
                pcall(loc.LocalSetTarget, loc, b)
            end
            if cur > lastDmg + 1e-6 then lastDmg, lastDmgAt = cur, os.clock() end
            -- 0.6 s không tích thêm damage -> client không nhận target (bị che / ngoài tầm 41 stud) -> bỏ
            if os.clock() - lastDmgAt > 0.6 then
                Stats.occluded += 1
                Bot.hold = nil Bot.target = nil
                skipUntil[b] = os.clock() + 3
                return false, "occluded"
            end
            if hard and os.clock() - lastUI > 1 then
                lastUI = os.clock()
                SetStatus(("giữ %s %d/%ds  zone %d y=%d"):format(id, math.floor(os.clock() - t0), math.ceil(clientSec), Stats.zone, Stats.layer))
                if os.clock() - (Bot.lastUI or 0) > 1 then Bot.lastUI = os.clock() UpdateUI() end
                -- block lâu: bị bom / rơi ra ngoài tầm hoặc mine reset -> huỷ
                local h = HRP()
                if loc.Respawning or not h or (BlockCenter(b) - h.Position).Magnitude > Config.ReachStuds + 2 then
                    Bot.hold = nil Bot.target = nil
                    skipUntil[b] = os.clock() + 5
                    Dbg("Huỷ %s: ngoài tầm / reset", id)
                    return false, "occluded"
                end
            end
        end
    end
    Bot.hold = nil Bot.target = nil
    if not b.TempBroken then
        Stats.occluded += 1
        Log("Giữ %s tại %s không vỡ sau %.0fs (damage %.1f/%d)", id, tostring(b.Pos), timeout, lastDmg, hp)
        skipUntil[b] = os.clock() + 30
        return false, "occluded"
    end
    skipUntil[b] = os.clock() + 30
    return false
end


local function ReturnToTop(loc)
    pcall(function()
        local btn = lp.PlayerGui._INSTANCES[Config.InstanceName].Return
        local f = getconnections(btn.Activated)[1].Function
        local bus = debug.getupvalues(f)[1]
        if bus and bus.Fire then bus.Fire("Mining Event: Went to top") end
    end)
    task.wait(2.5)
    local hrp = HRP()
    if hrp and loc and hrp.Position.Y < loc.Origin.Position.Y - 2 then
        local top
        for _, b in pairs(loc.Blocks) do
            if BlockValid(b) and not b.TempBroken and b.Pos.Y == 0 then top = b break end
        end
        hrp.CFrame = top and (top:GetCFrame() + Vector3.new(0, 6, 0)) or (loc.Origin + Vector3.new(0, 6, 0))
    end
    hopVisited = {}
end

