local function EnsureInstance()
    if InstancingCmds.IsInInstance() then return true end
    SetStatus("Enter event")
    Log("Vào event %s", Config.InstanceName)
    pcall(InstancingCmds.Enter, Config.InstanceName)
    local t0 = os.clock()
    repeat task.wait(0.5) until InstancingCmds.IsInInstance() or os.clock() - t0 > 25
    return InstancingCmds.IsInInstance()
end

local function GetLocalWorld(timeout)
    local t0 = os.clock()
    while os.clock() - t0 < (timeout or 10) do
        local ok, loc = pcall(BlockWorldClient.GetLocal)
        if ok and loc and not loc.Destroyed then return loc end
        task.wait(0.4)
    end
end

local function HRP()
    return lp.Character and lp.Character:FindFirstChild("HumanoidRootPart")
end
-- GetLocal() (world theo vị trí nhân vật) có khớp world đang farm và nhân vật đang trong vùng mine không
local function SameWorld(loc)
    local hrp = HRP()
    if not hrp or not loc or loc.Destroyed then return false end
    local ok, cur = pcall(BlockWorldClient.GetLocal)
    if not ok or cur ~= loc then return false end
    local inside = false
    pcall(function() inside = loc:IsInsideXZ(hrp.Position) end)
    return inside
end
-- sau khi tele về từ egg/máy: chờ tới khi GetLocal() khớp lại (tối đa 3 s)
local function WaitWorld(loc)
    local t0 = os.clock()
    repeat task.wait(0.2) until SameWorld(loc) or os.clock() - t0 > 3
end

-- số khu (1-5) của một BlockWorld theo vị trí Origin (loc.Id không phải số khu)
local function ZoneOf(loc)
    if not loc or not loc.Origin then return 0 end
    local p = loc.Origin.Position
    local best, bd = 0, nil
    for n, o in pairs(Config.ZoneOrigin) do
        local d = (Vector2.new(o.X, o.Z) - Vector2.new(p.X, p.Z)).Magnitude
        if not bd or d < bd then best, bd = n, d end
    end
    return best
end
local function TeleportToZoneTop(n)
    local o = Config.ZoneOrigin[n]
    local hrp = HRP()
    if not o or not hrp then return false end
    hrp.CFrame = CFrame.new(o + Vector3.new(0, 5.5, 0))
    task.wait(1.5)
    return true
end
-- về chỗ đang đào sau chuyến egg/máy. VERIFIED 21/09: tele thẳng từ khu 1 về chỗ sâu (y=-150) khu 2 -> block quanh đó chưa stream
-- -> rơi xuyên -> floor watchdog của game ném lên mặt KHU 1. Nên: lên mặt khu trước, chờ block dưới chỗ cũ load, rồi mới xuống
local function ReturnTo(loc, back)
    local hrp = HRP()
    if not hrp or not back then return end
    local zone = ZoneOf(loc)
    local top = Config.ZoneOrigin[zone]
    if top and (back.Position - top).Magnitude > 12 then
        hrp.CFrame = CFrame.new(top + Vector3.new(0, 5.5, 0))
        local t0 = os.clock()
        repeat
            task.wait(0.25)
            local okp, p = pcall(loc.WorldToBlockPos, loc, back.Position - Vector3.new(0, 3, 0))
            local b = okp and p and loc:GetBlock(p)
            if b and b.Part and b.Part.Parent and SameWorld(loc) then break end
        until os.clock() - t0 > 4
    end
    hrp = HRP()
    if hrp then hrp.CFrame = back end
    task.wait(0.6)
    WaitWorld(loc)
    -- vẫn bị ném đi (rơi xuyên) -> lên mặt khu, bot tự đào xuống lại
    hrp = HRP()
    if hrp and (hrp.Position - back.Position).Magnitude > 30 and top then
        Log("Về chỗ cũ thất bại (bị ném tới %s) -> lên mặt khu %d", tostring(hrp.Position), zone)
        hrp.CFrame = CFrame.new(top + Vector3.new(0, 5.5, 0))
        task.wait(1)
    end
end

