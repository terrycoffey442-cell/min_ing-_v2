    repeat
        task.wait(0.3)
        local standing = false
        pcall(function() standing = MachineCmds and MachineCmds.IsStandingOn(name) end)
        if standing then break end
    until os.clock() - t0 > 4
    task.wait(0.8) -- server nhận vị trí
