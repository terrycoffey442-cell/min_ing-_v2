-- ============================================================
local skipUntil, ghostFails, pending = {}, {}, {}
local hopVisited, oreHopTried = {}, {}

local function BlockValid(b)
    return b ~= nil and b.Part ~= nil and b.Part.Parent ~= nil
end
local idCache = setmetatable({}, { __mode = "k" })
local function BlockId(b)
    local c = idCache[b]
    if c then return c end
    local ok, dir = pcall(b.GetDirectory, b)
    c = ok and dir and dir._id or "?"
    if c ~= "?" then idCache[b] = c end
    return c
end
local function BlockHP(b)
    local ok, dir = pcall(b.GetDirectory, b)
    return (ok and dir and dir.Strength or 1) * 10
end
local function BlockCenter(b)
    local ok, cf = pcall(b.GetCFrame, b)
    if ok and cf then return cf.Position end
    return b.Part and b.Part.Position or Vector3.zero
end
local function IsOre(id) return (Config.Priority[id] or 1) >= 50 end
-- block "quá chậm": HP / damage > Max Block Sec giây server -> bỏ qua (Amethyst ~5 phút). Block cần > HardFrames frame client
-- vẫn đào được nhờ bot tự gửi commit (xem MineBlock).
local BlockDamage -- định nghĩa bên dưới
-- hardCache[id] = true chỉ khi bị ép bỏ (commit fail 6 lần); còn lại tính theo giây server (hardSec), tính lại mỗi 60 s
-- vì damage đổi khi có pet mới (egg) / gold / rainbow / pickaxe mới. Block quest/gate đang cần được nới tới Quest Max Sec
-- (acc mới: Scrap Pickaxe đào Sapphire ~29 s > Max Ore Sec 20 nhưng Quest 1 cần 1 Sapphire -> không nới thì kẹt mãi ở khu 1)
local hardSec, hardLogged, hardSecAt = {}, {}, 0
local function HardBlock(b, id)
    if hardCache[id] == true then return true end
    if not BlockDamage then return false end
    if os.clock() - hardSecAt > 60 then hardSecAt = os.clock() table.clear(hardSec) end
    local sec = hardSec[id]
    if sec == nil then
        local ok, dir = pcall(b.GetDirectory, b)
        local hp = (ok and dir and dir.Strength or 1) * 10
        local fps = math.max(20, tonumber(_UC["FPS"]) or 60)
        local dmg = BlockDamage(b)
        sec = hp / dmg
        hardSec[id] = sec
        hardFrames[id] = math.ceil(hp / (dmg / fps))
    end
    local maxSec = IsOre(id) and (tonumber(_UC["Max Ore Sec"]) or 400) or (tonumber(_UC["Max Block Sec"]) or 30)
    local quest = (Bot.questNeeds and Bot.questNeeds[id]) or (Bot.gateNeeds and Bot.gateNeeds[id])
    if quest then maxSec = math.max(maxSec, tonumber(_UC["Quest Max Sec"]) or 120) end
    local c = sec > maxSec
    local key = id .. (c and "-skip" or "-ok") .. (quest and "-q" or "")
    if not hardLogged[key] then
        hardLogged[key] = true
        if c then Log("Block %s cần %.0f s -> quá chậm, bỏ qua", id, sec)
        elseif hardFrames[id] > Config.HardFrames then Log("Block %s cần %d frame (%.1f s)%s -> giữ tích damage", id, hardFrames[id], sec, quest and " [quest]" or "") end
    end
    return c
end
local tierCache = {}
local function BlockTier(b, id)
    local c = tierCache[id]
    if c then return c end
    local ok, dir = pcall(b.GetDirectory, b)
    c = ok and dir and tonumber(dir.Tier) or 1
    tierCache[id] = c
    return c
end

-- block chân thật: GetPlayerBlock nhảy y/y-1 ở ranh giới + có thể trả ghost
local function GetFootPos(loc)
    local pb = loc:GetPlayerBlock(lp)
    if not pb then
        -- GetPlayerBlock dùng BottomCFrame nhân vật: tuỳ avatar (R15 HipHeight ~2) chân nằm đúng mép block -> trả nil ~70 % thời gian
        -- (VERIFIED 21/09 acc mới) -> tự tính từ HRP hạ 3 / 4.5 stud
        local hrp = HRP()
        if hrp then
            for _, dy in ipairs({ -3, -4.5, -1.5 }) do
                local ok, p = pcall(loc.WorldToBlockPos, loc, hrp.Position + Vector3.new(0, dy, 0))
                if ok and p then pb = p break end
            end
        end
        if not pb then return nil end
    end
    for y = pb.Y, pb.Y - 3, -1 do
        local b = loc:GetBlock(Vector3int16.new(pb.X, y, pb.Z))
        if b and not b.TempBroken and b.Part and b.Part.Parent then return b.Pos end
    end
    return pb
end

local function HopTo(b)
    local hrp = HRP()
    if not hrp then return false end
    local dest = BlockCenter(b) + Vector3.new(0, 5.7, 0)
    for attempt = 1, 3 do
        hrp.CFrame = CFrame.new(dest)
        task.wait(0.4)
        hrp = HRP()
        if hrp and (hrp.Position - dest).Magnitude < 12 then return true end
        -- tele không ăn (đang rơi do bom / lag) -> thử lại
        task.wait(0.3)
    end
    return false
end

local function PickTarget(loc, pb, reach)
    reach = reach or Config.ReachStuds
    local best, bestScore
    local layerLeft = 0
    local farBest, farScore, farCount = nil, nil, 0
    local ghostBest
    local now = os.clock()
    local hrp = HRP()
    local me = hrp and hrp.Position
    local needs = Bot.questNeeds or {}
    for _, b in pairs(loc.Blocks) do
        if BlockValid(b) and (skipUntil[b] or 0) < now and not pending[b] then
            local pos = b.Pos
            local isFoot = pb and pos.X == pb.X and pos.Y == pb.Y and pos.Z == pb.Z
            local id = (not isFoot and pb) and BlockId(b) or nil
            if id and HardBlock(b, id) then id = nil end -- primitive không phá được -> bỏ qua (Auto Mine lo)
            local ore = id and IsOre(id)
            -- block thường: chỉ layer đang đứng (+ vành layer trên); ore: mọi layer từ pb.Y-1 trở lên (kể cả ore bỏ sót ở trên)
            if id and ((pos.Y == pb.Y or pos.Y == pb.Y + 1) or ore) then -- ore: mọi layer (trong tầm đào luôn, ngoài tầm thì tele tới rồi quay về)
                local pri = Config.Priority[id] or 1
                if needs[id] then pri += Config.QuestBonus end
                -- ore lâu (Amethyst/Rainbow > 10 s giữ target): xếp sau mọi ore nhanh và cả block thường trong tầm
                local slowOre = ore and (hardFrames[id] or 0) / math.max(20, tonumber(_UC["FPS"]) or 60) > 10
                if slowOre then pri = 0.5 end
                local dist = me and (BlockCenter(b) - me).Magnitude or 0
                -- ore luôn dùng tầm đầy đủ; block thường dùng tầm thu hẹp khi đang "đào xuống tìm đá quest"
                if dist <= (ore and Config.ReachStuds or reach) then
                    if b.TempBroken then
                        -- ghost (client đoán vỡ nhưng Part còn): chỉ thử khi hết block thường
                        if not ghostBest then ghostBest = b end
                    else
                        layerLeft += 1
                        local score = pri * 1000 - dist / 5
                        if not bestScore or score > bestScore then best, bestScore = b, score end
                    end
                elseif pos.Y == pb.Y or (ore and (_UC["Ore First"] or math.abs(pos.Y - pb.Y) <= 1)) then
                    -- hop: block thường cùng layer; ore trong ±1 layer (Ore First: mọi layer) -> đi lấy rồi quay về
                    farCount += 1
                    local above = loc:GetBlock(Vector3int16.new(pos.X, pos.Y + 1, pos.Z))
                    if not BlockValid(above) then
                        local c = BlockCenter(b)
                        local farFromVisited = true
                        if not ore then
                            for _, v in ipairs(hopVisited) do
                                if v.y == pos.Y and (v.pos - c).Magnitude < Config.HopMinSpacing then farFromVisited = false break end
                            end
                        end
                        -- ore xa luôn thắng block thường xa; trong cùng loại thì gần nhất
                        local sc = (ore and (slowOre and 5e5 or 1e6) or 0) - dist
                        if farFromVisited and (not farScore or sc > farScore) then farBest, farScore = b, sc end
                    end
                end
            end
        end
    end
    return best, layerLeft, farBest, farCount, ghostBest
end

-- đứng lên block lộ thiên cạnh b (để có line of sight tới ore bị che / ore ở xa)
local function HopNear(loc, b)
    local bp = b.Pos
    local cand, cd
    for dx = -2, 2 do
        for dz = -2, 2 do
            if dx ~= 0 or dz ~= 0 then
                for _, dy in ipairs({ 0, -1 }) do
                    local n = loc:GetBlock(Vector3int16.new(bp.X + dx, bp.Y + dy, bp.Z + dz))
                    if BlockValid(n) and not n.TempBroken and not IsOre(BlockId(n)) then
                        local above = loc:GetBlock(Vector3int16.new(n.Pos.X, n.Pos.Y + 1, n.Pos.Z))
                        if not BlockValid(above) then
                            local d = math.abs(dx) + math.abs(dz) + (dy == 0 and 0 or 0.5)
                            if not cd or d < cd then cand, cd = n, d end
                        end
                    end
                end
            end
        end
    end
    if cand then return HopTo(cand), false end
    return HopTo(b), true -- không có chỗ đứng cạnh -> đứng lên chính ore đó (đào block chân)
end

-- ore gần nhất còn đào được (mọi layer) – cho chuỗi "sweep" ore
local function NearestOre(loc)
    local hrp = HRP()
    if not hrp then return nil end
    local now = os.clock()
    local best, bd
    for _, b in pairs(loc.Blocks) do
        if BlockValid(b) and not b.TempBroken and (skipUntil[b] or 0) < now and not pending[b] then
            local id = BlockId(b)
            if IsOre(id) and not HardBlock(b, id) then
                local d = (BlockCenter(b) - hrp.Position).Magnitude
                if not bd or d < bd then best, bd = b, d end
            end
        end
    end
    return best, bd
end

-- block lộ thiên gần nhất ở layer pb.Y-1 .. pb.Y-maxDy (để nhảy xuống)
local function FindExposedBelow(loc, pb, maxDy)
    local hrp = HRP()
    if not hrp then return nil end
    for dy = 1, maxDy do
        local below, bd
        for _, b in pairs(loc.Blocks) do
            if BlockValid(b) and not b.TempBroken and b.Pos.Y == pb.Y - dy then
                local above = loc:GetBlock(Vector3int16.new(b.Pos.X, b.Pos.Y + 1, b.Pos.Z))
                if not BlockValid(above) then
                    -- ore là mesh to, đứng lên dễ trượt ra ngoài vùng -> ưu tiên block thường
                    local d = (BlockCenter(b) - hrp.Position).Magnitude + (IsOre(BlockId(b)) and 1000 or 0)
                    if not bd or d < bd then below, bd = b, d end
                end
            end
        end
        if below then return below end
    end
    return nil
end

-- block lộ thiên (không phải ore) gần nhân vật nhất ở mọi layer – để nhảy về khi bị văng ra ngoài vùng
local function NearestExposedBlock(loc, maxDist, innerOnly)
    local hrp = HRP()
    if not hrp then return nil end
    local best, bd
    for _, b in pairs(loc.Blocks) do
        -- innerOnly: cách mép vùng >= 2 block (vùng x/z -8..7) để không bị bom/mesh đẩy ra ngoài lần nữa
        if BlockValid(b) and not b.TempBroken and (not innerOnly or (b.Pos.X >= -6 and b.Pos.X <= 5 and b.Pos.Z >= -6 and b.Pos.Z <= 5)) then
            local above = loc:GetBlock(Vector3int16.new(b.Pos.X, b.Pos.Y + 1, b.Pos.Z))
            if not BlockValid(above) then
                local d = (BlockCenter(b) - hrp.Position).Magnitude + (IsOre(BlockId(b)) and 1000 or 0)
                if d <= (maxDist or 1e9) and (not bd or d < bd) then best, bd = b, d end
            end
        end
    end
    return best
end

local lastTargetAt = 0
local function SetTarget(loc, b)
    lastTargetAt = os.clock()
    local ok1 = pcall(loc.PlayerSetTarget, loc, lp, b.Pos, true)
    local ok2 = pcall(loc.LocalSetTarget, loc, b)
    return ok1 and ok2
end

local function Confirm(b, id, t0)
    Stats.broken += 1
    Stats.byId[id] = (Stats.byId[id] or 0) + 1
    if IsOre(id) then Stats.ores += 1 end
    Dbg("vỡ %-12s %s (%.2fs)", id, tostring(b.Pos), os.clock() - t0)
end

local function TrackPending()
    local now = os.clock()
    for b, info in pairs(pending) do
        if not b.Part or b.Part.Parent == nil then
            pending[b] = nil
            Confirm(b, info.id, info.t0)
        elseif now - info.t0 > Config.ConfirmTimeout then
            pending[b] = nil
            if not b.TempBroken then
                Stats.rejected += 1
                skipUntil[b] = now + Config.RejectRetry
            else
                ghostFails[b] = (ghostFails[b] or 0) + 1
                skipUntil[b] = now + (ghostFails[b] >= Config.GhostMaxFails and 600 or Config.GhostSkip)
            end
        end
    end
end

