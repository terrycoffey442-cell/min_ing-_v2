local lastEggAt, nextEggWait = 0, 0
local function DoEggs(loc)
    if not _UC["Auto Egg"] or not CustomEggsCmds then return end
    if os.clock() - lastEggAt < nextEggWait then return end
    local ev = _UC["Egg Every"]
    local lo, hi = 10, 20
    if type(ev) == "table" then lo, hi = tonumber(ev[1]) or 10, tonumber(ev[2]) or 20 elseif tonumber(ev) then lo, hi = tonumber(ev), tonumber(ev) end
    lastEggAt = os.clock()
    nextEggWait = math.random(math.floor(lo * 10), math.floor(math.max(lo, hi) * 10)) / 10
    if not loc or loc.Respawning or GameAutoMineOn() then return end -- Auto Mine của game đang bật thì nó kéo nhân vật xuống ngay -> "too far"
    -- chọn egg
    local id = _UC["Egg"]
    if id == nil or id == "auto" then id = Config.ZoneEgg[HighestUnlockedZone()] end
    local cost = EggCost(id)
    local avail = GetSpaceCoins() - EggReserve()
    if avail < cost then return end
    local egg = FindEgg(id)
    if not egg or not egg._position then Dbg("Egg %s chưa load (CustomEggsCmds)", tostring(id)) return end
    -- số trứng
    local maxHatch = 1
    pcall(function() maxHatch = EggCmds and EggCmds.GetMaxHatch() or SaveData().EggHatchCount or 1 end)
    pcall(function() local m = egg:GetMaxEggCount() if tonumber(m) and m > 0 then maxHatch = math.min(maxHatch, m) end end)
    local want = _UC["Egg Count"]
    local n = math.min(maxHatch, math.floor(avail / cost), (tonumber(want) and tonumber(want) > 0) and tonumber(want) or maxHatch)
    if n < 1 then return end
    -- tele lên egg (giữ chỗ đang đào để quay về)
    local hrp = HRP()
    if not hrp then return end
    local back = hrp.CFrame
    SetStatus(("egg %s x%d"):format(id, n))
    local pos = egg._position
    hrp.CFrame = CFrame.new(pos + Vector3.new(0, 1, 5), pos)
    task.wait(1.1)
    local ok, res, err = false, false, "stopped"
    for _ = 1, 4 do -- vị trí replicate ~1 s; "too far" thì chờ thêm
        if not Bot.running then break end
        ok, res, err = pcall(Network.Invoke, "CustomEggs_Hatch", egg._uid, n)
        if not (ok and res == false and tostring(err):find("far")) then break end
        task.wait(0.5)
    end
    if ok and res then
        Stats.eggs += n
        Stats.lastEvent = ("Egg %s x%d"):format(id, n)
        Log("Mở %s x%d (coins còn %s)", id, n, FmtNum(GetSpaceCoins()))
        task.wait(0.8) -- chờ pet mới vào túi rồi mới ra máy
        MachinePass()
        if _UC["Equip Best Pets"] then pcall(Network.Fire, "SM_Optimize") end
    else
        Log("Mở %s x%d thất bại: %s", id, n, tostring(err or res))
        -- server từ chối (thiếu tiền theo server / egg khoá) -> nghỉ lâu hơn
        nextEggWait = math.max(nextEggWait, 30)
    end
    -- quay về chỗ đang đào
    ReturnTo(loc, back)
    return true -- đã tele đi/về: client có thể dựng lại BlockWorld -> vòng ngoài phải lấy lại loc
end

